# Manus supplies these values in the managed project. Never commit actual values.
# Server-only database DSN and secrets:
DATABASE_URL=
MANUS_JWT_SECRET=
MANUS_API_KEY=
MANUS_API_URL=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
