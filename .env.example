# Manus supplies these values in the managed project. Never commit actual values.
# Server-only database DSN and secrets:
DATABASE_URL=
MANUS_JWT_SECRET=
MANUS_API_KEY=
MANUS_API_URL=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_PROJECT_ID=

# Public app/runtime configuration. Use a reachable HTTPS API for release builds.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=

# Managed runtime/redirect values supplied by Manus; do not hardcode dev hostnames.
EXPO_WEB_PREVIEW_URL=
EXPO_PACKAGER_PROXY_URL=

# Optional authentication providers — server-only; configure through protected secrets.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET aliases are also supported.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Production overrides (fixed HTTPS origins, never caller-supplied URLs):
AUTH_PUBLIC_FRONTEND_URL=
AUTH_PUBLIC_API_URL=
