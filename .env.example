# Public app/runtime configuration. Use a reachable HTTPS API for release builds.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=

# Managed runtime/redirect values supplied by Manus; do not hardcode dev hostnames.
EXPO_WEB_PREVIEW_URL=
EXPO_PACKAGER_PROXY_URL=
